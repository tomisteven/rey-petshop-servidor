# Configuración del Servidor
PORT=5000
NODE_ENV=production

# Base de Datos (MongoDB Atlas)
MONGODB_URI=
USERNAME_DB=
PASSWORD_DB=

# Seguridad
JWT_SECRET=cambia_esta_clave_secreta
JWT_EXPIRES_IN=1d

# CORS (URL del Frontend separadas por coma: local y producción/Netlify)
CLIENT_URL=http://localhost:5173,https://tu-sitio.netlify.app

# OpenAI (generación de promociones y funciones IA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
